# Copy to .env only when GEMINI_API_KEY is not already configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
HOST=127.0.0.1
# Optional: use the same database path for desktop and iPhone startup.
# SQLITE_PATH=data/night-harbor.sqlite
# Enable only when the site is served over HTTPS, not local HTTP.
# SECURE_COOKIES=1
# Fixed HTTPS startup: use the account-assigned domain from dashboard.ngrok.com/domains.
# PUBLIC_URL=https://your-assigned-domain.ngrok-free.dev
# PUBLIC_PORT=3001
